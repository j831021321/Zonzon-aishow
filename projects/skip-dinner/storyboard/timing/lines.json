[
 {
  "line": 1,
  "text": "晚餐不吃，真的會比較好嗎？",
  "start": 0.3,
  "end": 2.56
 },
 {
  "line": 2,
  "text": "很多女生想調整體態，第一件事就是戒晚餐。",
  "start": 2.82,
  "end": 6.98
 },
 {
  "line": 3,
  "text": "先看胃。",
  "start": 7.1,
  "end": 8.02
 },
 {
  "line": 4,
  "text": "胃會分泌「飢餓素」，提醒你該吃飯了。",
  "start": 8.1,
  "end": 11.3
 },
 {
  "line": 5,
  "text": "研究發現，它在飯前會升到快兩倍，吃完才降下來。",
  "start": 11.52,
  "end": 17.2
 },
 {
  "line": 6,
  "text": "跳過晚餐，它就少了一次降下來的機會。",
  "start": 17.74,
  "end": 20.82
 },
 {
  "line": 7,
  "text": "所以有些人撐到半夜，反而更想吃。",
  "start": 21.04,
  "end": 24.4
 },
 {
  "line": 8,
  "text": "再看肌肉。",
  "start": 24.4,
  "end": 25.76
 },
 {
  "line": 9,
  "text": "有個小型研究發現，蛋白質平均分到三餐，",
  "start": 25.86,
  "end": 29.9
 },
 {
  "line": 10,
  "text": "會比集中在晚餐，一天的肌肉合成多了約百分之二十五。",
  "start": 29.9,
  "end": 35.54
 },
 {
  "line": 11,
  "text": "晚餐不吃，蛋白質就剩下兩餐可以分。",
  "start": 35.92,
  "end": 40.24
 },
 {
  "line": 12,
  "text": "白天吃多，晚餐就簡單點。",
  "start": 40.78,
  "end": 43.42
 },
 {
  "line": 13,
  "text": "有運動，就搭配蛋白質、蔬菜和一點澱粉。",
  "start": 43.98,
  "end": 48.02
 },
 {
  "line": 14,
  "text": "吃得晚，就選清淡好消化的。",
  "start": 48.14,
  "end": 51.32
 },
 {
  "line": 15,
  "text": "身材管理不是餓自己，而是看懂一整天吃了什麼。",
  "start": 51.54,
  "end": 55.76
 },
 {
  "line": 16,
  "text": "我是佳蓉，飲食教練。",
  "start": 56.04,
  "end": 57.98
 },
 {
  "line": 17,
  "text": "想知道你一整天到底有沒有吃對嗎？",
  "start": 58.06,
  "end": 61.06
 },
 {
  "line": 18,
  "text": "留言或私訊「外食」，預約免費飲食諮詢！",
  "start": 61.46,
  "end": 66.16
 }
]