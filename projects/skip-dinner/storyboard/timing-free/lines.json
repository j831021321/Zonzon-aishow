[
 {
  "line": 1,
  "text": "晚餐不吃，真的會比較好嗎？",
  "start": 0.0,
  "end": 1.72
 },
 {
  "line": 2,
  "text": "很多女生想調整體態，第一件事就是戒晚餐。",
  "start": 1.88,
  "end": 5.42
 },
 {
  "line": 3,
  "text": "先看胃。",
  "start": 5.54,
  "end": 6.28
 },
 {
  "line": 4,
  "text": "胃會分泌「飢餓素」，提醒你該吃飯了。",
  "start": 6.36,
  "end": 9.06
 },
 {
  "line": 5,
  "text": "研究發現，它在飯前會升到快兩倍，吃完才降下來。",
  "start": 9.38,
  "end": 13.34
 },
 {
  "line": 6,
  "text": "跳過晚餐，它就少了一次降下來的機會。",
  "start": 13.62,
  "end": 16.7
 },
 {
  "line": 7,
  "text": "所以有些人撐到半夜，反而更想吃。",
  "start": 16.96,
  "end": 19.52
 },
 {
  "line": 8,
  "text": "再看肌肉。",
  "start": 19.82,
  "end": 20.7
 },
 {
  "line": 9,
  "text": "有個小型研究發現，蛋白質平均分到三餐，",
  "start": 20.78,
  "end": 24.5
 },
 {
  "line": 10,
  "text": "會比集中在晚餐，一天的肌肉合成多了約百分之二十五。",
  "start": 24.62,
  "end": 28.3
 },
 {
  "line": 11,
  "text": "晚餐不吃，蛋白質就剩下兩餐可以分。",
  "start": 28.3,
  "end": 31.6
 },
 {
  "line": 12,
  "text": "白天吃多，晚餐就簡單點。",
  "start": 31.7,
  "end": 33.72
 },
 {
  "line": 13,
  "text": "有運動，就搭配蛋白質、蔬菜和一點澱粉。",
  "start": 33.9,
  "end": 37.12
 },
 {
  "line": 14,
  "text": "吃得晚，就選清淡好消化的。",
  "start": 37.24,
  "end": 39.34
 },
 {
  "line": 15,
  "text": "身材管理不是餓自己，而是看懂一整天吃了什麼。",
  "start": 39.66,
  "end": 42.96
 },
 {
  "line": 16,
  "text": "我是佳蓉，飲食教練。",
  "start": 43.16,
  "end": 44.66
 },
 {
  "line": 17,
  "text": "想知道你一整天到底有沒有吃對嗎？",
  "start": 44.76,
  "end": 47.18
 },
 {
  "line": 18,
  "text": "留言或私訊「外食」，預約免費飲食諮詢！",
  "start": 47.32,
  "end": 50.98
 }
]